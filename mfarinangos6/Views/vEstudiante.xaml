<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mfarinangos6.Views.vEstudiante">
    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Label Grid.Row="0"
               Text="Semana 6: Servicios web - Estudiante"
               VerticalOptions="Center"
               FontSize="20"
               HorizontalOptions="Center" />

        <ListView x:Name="listaEstudiante"
                  Grid.Row="1"
                  ItemsSource="{Binding Estudiantes}"
                  ItemSelected="listaEstudiante_ItemSelected">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Spacing="20" Padding="20">
                            <Grid RowSpacing="15" ColumnSpacing="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Label Text="{Binding Codigo}" Grid.Row="0" Grid.Column="0" />
                                <Label Text="{Binding Nombre}" Grid.Row="0" Grid.Column="1" />
                                <Label Text="{Binding Apellido}" Grid.Row="0" Grid.Column="2" />
                                <Label Text="{Binding Edad}" Grid.Row="0" Grid.Column="3" />
                            </Grid>
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="2"
                Text="Agregar"
                HeightRequest="50"
                BackgroundColor="#512BD4"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="btnAgregarEstudiante_Clicked" />
    </Grid>
</ContentPage>
